# Copy this file to .env.local and fill in the values from your Appwrite
# project (Appwrite console -> your project -> Settings). .env.local is
# already excluded by .gitignore, so it's safe to put real secrets there.

# Safe to expose to the browser
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=main

# Secret! Server-only API key. Never prefix this with NEXT_PUBLIC_.
APPWRITE_API_KEY=
